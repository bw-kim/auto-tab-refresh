{
  "manifest_version": 3,
  "name": "탭 자동 새로고침",
  "version": "1.0.0",
  "description": "팝업에서 탭마다 새로고침 간격을 설정합니다.",
  "minimum_chrome_version": "120",
  "permissions": ["alarms", "storage", "tabs"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "탭 자동 새로고침", "default_popup": "popup.html", "default_icon": {"16":"icons/icon16.png","32":"icons/icon32.png","48":"icons/icon48.png","128":"icons/icon128.png"}},
  "icons": {"16":"icons/icon16.png","32":"icons/icon32.png","48":"icons/icon48.png","128":"icons/icon128.png"}
}